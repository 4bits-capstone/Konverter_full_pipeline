VITE_API_BASE_URL=http://localhost:8000/api
VITE_API_TIMEOUT_MS=30000
VITE_SUPABASE_URL=                # ask a team lead for the Supabase project URL
VITE_SUPABASE_ANON_KEY=           # ask a team lead for the Supabase anon public key

KONVERTER_CORS_ORIGINS=http://localhost:5173
KONVERTER_DO_OCR=false
KONVERTER_DO_TABLE_STRUCTURE=true
KONVERTER_DOCLING_DEVICE=cpu #change to cuda if you have a GPU and want to use it
KONVERTER_WORKERS=1
KONVERTER_HIGH_CONFIDENCE=0.75
KONVERTER_MEDIUM_CONFIDENCE=0.60
KONVERTER_MAX_PAGES=2000
KONVERTER_BASELINE_STARTUP_SECONDS=30
KONVERTER_LOG_LEVEL=INFO
KONVERTER_API_DOCS=true # /docs and /openapi.json; the production image sets false

KONVERTER_SITE_URL=https://www.lawreform.vic.gov.au
KONVERTER_SITE_NAME=Victorian Law Reform Commission
KONVERTER_PAGE_URL_TEMPLATE=https://www.lawreform.vic.gov.au/publication/{slug}/
KONVERTER_PUBLIC_API_URL=backendURL 
KONVERTER_DEFAULT_LICENSE_URL=https://creativecommons.org/licenses/by/4.0/
KONVERTER_DEFAULT_COPYRIGHT_HOLDER=Victorian Law Reform Commission
KONVERTER_DESCRIPTION_MAX_CHARS=600

KONVERTER_BASELINE_SECONDS_PER_PAGE=2.8

SUPABASE_URL=                     # same as VITE_SUPABASE_URL
SUPABASE_ANON_KEY=                # same as VITE_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=        # ask a team lead; backend only, never exposed to the frontend

# Powers the document chat assistant (/api/chat, /api/tts). Backend only,
# never exposed to the frontend.
OPENAI_API_KEY=
# Caps on the public (no-login) widget chat, which spends OpenAI credit.
# 0 disables a cap.
KONVERTER_PUBLIC_CHAT_PER_IP_PER_MINUTE=10
KONVERTER_PUBLIC_CHAT_GLOBAL_PER_HOUR=300

# Optional: VLM-assisted structure classification for pages a purely
# geometric check can't confidently split (see app/diagram_vlm.py). Only
# ever used to decide *grouping* between text Docling already extracted,
# never to supply document text itself. Leave blank to skip this check
# entirely -- affected pages fall back to being flagged for human review.
CLAUDE_API_KEY=

# Remote Docling mode: offloads GPU parsing to a RunPod serverless worker via
# Supabase Storage. Leave KONVERTER_DOCLING_MODE=local (or unset) to keep
# parsing in-process, which is still the default.
KONVERTER_DOCLING_MODE=local #local|remote
KONVERTER_DOCLING_ENDPOINT_URL= #https://api.runpod.ai/v2/<ENDPOINT_ID>
KONVERTER_RUNPOD_API_KEY=
KONVERTER_STORAGE_BUCKET=konverter-docs
KONVERTER_SIGNED_URL_TTL=3600
KONVERTER_RUNPOD_JOB_TIMEOUT_SECONDS=1800 # give up on (and cancel) a remote Docling job after this long

# WP-02 Nam Builder API. Put the token only (without "Bearer ") in your local
# root .env, never in this example or any VITE_ variable. Draft-only testing.
KONVERTER_WORDPRESS_PUBLISH_URL=https://vlrc.komosion.com/wp-json/nam-builder/v1/pages
KONVERTER_WORDPRESS_BEARER_TOKEN=
KONVERTER_WORDPRESS_TIMEOUT_SECONDS=30

# --- RAG (python -m app.rag ...) -------------------------------------------------------------
# Embeddings: provider, model and size are config, never code. The size must match the SQL you
# rendered with `python -m app.rag sql` (backend/sql/006_rag_chunks.sql). Changing the model
# re-embeds on the next ingest; changing the size also means re-creating rag_chunks.
RAG_EMBED_PROVIDER=voyage
RAG_EMBED_MODEL=voyage-law-2
RAG_EMBED_DIM=1024
# Voyage key (provider=voyage). OpenAI uses OPENAI_API_KEY above (provider=openai).
VOYAGE_API_KEY=
# Optional: RAG_EMBED_BATCH=64, RAG_CHUNK_MAX_CHARS=2500, RAG_CACHE_DIR=<path for converted structured.json>
# Answering (python -m app.rag ask): DeepSeek, OpenAI-compatible. RAG_MIN_SIMILARITY is the floor below
# which a retrieved chunk is ignored; if nothing is left the answer is "Not found" and the model is not called.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
RAG_LLM_MODEL=deepseek-chat
RAG_TOP_K=8
RAG_MIN_SIMILARITY=0.3
