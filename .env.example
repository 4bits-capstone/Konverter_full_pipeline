VITE_API_BASE_URL=http://localhost:8000/api
VITE_API_TIMEOUT_MS=30000
VITE_SUPABASE_URL= askLinn
VITE_SUPABASE_ANON_KEY= askLinn

KONVERTER_CORS_ORIGINS=http://localhost:5173
KONVERTER_DO_OCR=false
KONVERTER_DO_TABLE_STRUCTURE=true
KONVERTER_DOCLING_DEVICE=cpu #change to cuda if you have a GPU and want to use it
KONVERTER_WORKERS=1
KONVERTER_HIGH_CONFIDENCE=0.75
KONVERTER_MEDIUM_CONFIDENCE=0.60
KONVERTER_MAX_PAGES=2000
KONVERTER_BASELINE_STARTUP_SECONDS=30
KONVERTER_LOG_LEVEL=INFO

KONVERTER_SITE_URL=https://www.lawreform.vic.gov.au
KONVERTER_SITE_NAME=Victorian Law Reform Commission
KONVERTER_PAGE_URL_TEMPLATE=https://www.lawreform.vic.gov.au/publication/{slug}/
KONVERTER_PUBLIC_API_URL=
KONVERTER_DEFAULT_LICENSE_URL=https://creativecommons.org/licenses/by/4.0/
KONVERTER_DEFAULT_COPYRIGHT_HOLDER=Victorian Law Reform Commission
KONVERTER_DESCRIPTION_MAX_CHARS=600

KONVERTER_BASELINE_SECONDS_PER_PAGE=2.8

SUPABASE_URL= askLinn
SUPABASE_ANON_KEY= askLinn
SUPABASE_SERVICE_ROLE_KEY= askLinn

# Powers the document chat assistant (/api/chat, /api/tts). Backend only,
# never exposed to the frontend.
OPENAI_API_KEY=
